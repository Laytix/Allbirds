<div class="featured-collections full-width">

  <div class="featured-collections__header">
    <div class="featured-collections__header-main">
      <p class="featured-collections__eyebrow">{{ section.settings.eyebrow | default: 'Shop by category' }}</p>
      <h2 class="featured-collections__heading">{{ section.settings.heading | default: 'Find your everyday pair' }}</h2>
    </div>

    {%- if section.settings.intro != blank -%}
      <p class="featured-collections__intro">{{ section.settings.intro }}</p>
    {%- endif -%}
  </div>

  {%- for i in (1..4) -%}
    {%- assign image_setting  = 'image_'  | append: i -%}
    {%- assign title_setting  = 'title_'  | append: i -%}
    {%- assign col_a_setting  = 'col_'    | append: i | append: '_a' -%}
    {%- assign col_b_setting  = 'col_'    | append: i | append: '_b' -%}

    {%- assign card_image  = section.settings[image_setting] -%}
    {%- assign card_title  = section.settings[title_setting] | default: 'Collection' -%}
    {%- assign col_a       = section.settings[col_a_setting] -%}
    {%- assign col_b       = section.settings[col_b_setting] -%}

    {%- assign has_col_a = false -%}
    {%- assign has_col_b = false -%}
    {%- if col_a != blank -%}
      {%- assign has_col_a = true -%}
    {%- endif -%}
    {%- if col_b != blank -%}
      {%- assign has_col_b = true -%}
    {%- endif -%}

    {%- comment -%} Whole card links to the first collection, or all products {%- endcomment -%}
    {%- assign card_link = col_a | default: col_b -%}
    {%- assign card_url  = card_link.url | default: routes.all_products_collection_url -%}

    {%- comment -%} Only show an extra link row when it adds information {%- endcomment -%}
    {%- assign show_links = false -%}
    {%- if has_col_b -%}
      {%- assign show_links = true -%}
    {%- endif -%}
    {%- if has_col_a and col_a.title != card_title -%}
      {%- assign show_links = true -%}
    {%- endif -%}

    <div class="featured-collections__item">

      <a
        class="featured-collections__card-link"
        href="{{ card_url }}"
        aria-label="{{ card_title | escape }}"
        tabindex="-1"
      >
        {%- if card_image -%}
          {{
            card_image
            | image_url: width: 800
            | image_tag:
              loading: 'lazy',
              class: 'featured-collections__img',
              widths: '400,600,800',
              sizes: '(max-width: 640px) calc(50vw - 1.125rem), (max-width: 1024px) calc(25vw - 1.125rem), calc(25vw - 1.5rem)'
          }}
        {%- else -%}
          <div class="featured-collections__placeholder"></div>
        {%- endif -%}
      </a>

      <div class="featured-collections__overlay" aria-hidden="true"></div>

      <div class="featured-collections__content">
        {%- if show_links -%}
          <div class="featured-collections__links">
            {%- if has_col_a -%}
              <a href="{{ col_a.url }}">{{ col_a.title }}</a>
            {%- endif -%}
            {%- if has_col_b -%}
              <a href="{{ col_b.url }}">{{ col_b.title }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}

        <div class="featured-collections__title-row">
          <a href="{{ card_url }}" class="featured-collections__title">{{ card_title }}</a>
          <span class="featured-collections__arrow" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M13 6l6 6-6 6"/>
            </svg>
          </span>
        </div>
      </div>
    </div>
  {%- endfor -%}
</div>

{% stylesheet %}
  .featured-collections {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
    margin: 0.75rem;
    width: calc(100% - 1.5rem);
  }

  /* ===== Section header ===== */
  .featured-collections__header {
    grid-column: 1 / -1;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2.5rem;
    padding: 4.25rem 0.25rem 2.25rem;
    border-bottom: 1px solid var(--color-line);
  }

  .featured-collections__eyebrow {
    margin: 0 0 0.9rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .featured-collections__heading {
    margin: 0;
    max-width: 14ch;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 3.4vw, 3.25rem);
    line-height: 0.98;
    letter-spacing: -0.02em;
    font-weight: 400;
    color: var(--color-ink);
    text-wrap: balance;
  }

  .featured-collections__intro {
    margin: 0 0 0.4rem;
    max-width: 36ch;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-muted);
  }

  .featured-collections__item {
    position: relative;
    overflow: hidden;
    border-radius: 0.75rem;
    aspect-ratio: 3 / 4;
    background: #1a1a1a;
    cursor: pointer;
  }

  /* Full-card link — sits under the overlay, which stays click-through */
  .featured-collections__card-link {
    position: absolute;
    inset: 0;
    display: block;
  }

  /* ── Image ── */
  .featured-collections__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .featured-collections__item:hover .featured-collections__img {
    transform: scale(1.05);
  }

  .featured-collections__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #1c1c1c 0%, #2e2e2e 50%, #1c1c1c 100%);
  }

  /* ── Bottom gradient — carries the label ── */
  .featured-collections__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(15, 12, 9, 0.8) 0%,
      rgba(15, 12, 9, 0.28) 42%,
      rgba(15, 12, 9, 0) 68%
    );
    opacity: 0.92;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  .featured-collections__item:hover .featured-collections__overlay {
    opacity: 1;
  }

  /* ── Bottom-left label + circular arrow ── */
  .featured-collections__content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 1.35rem 1.35rem 1.4rem;
    pointer-events: none;
  }

  .featured-collections__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.35s ease, transform 0.35s ease;
  }

  .featured-collections__links a {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.82);
    text-decoration: underline;
    text-underline-offset: 0.35em;
    pointer-events: auto;
  }

  .featured-collections__item:hover .featured-collections__links,
  .featured-collections__item:focus-within .featured-collections__links {
    opacity: 1;
    transform: none;
  }

  .featured-collections__title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
  }

  .featured-collections__title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2vw, 1.9rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: #ffffff;
    text-decoration: none;
    pointer-events: auto;
    text-shadow: 0 1px 18px rgba(0, 0, 0, 0.25);
  }

  .featured-collections__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    flex: none;
    background: rgba(16, 12, 9, 0.45);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 50%;
    color: #ffffff;
    transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
  }

  .featured-collections__item:hover .featured-collections__arrow {
    background: #f3efe7;
    border-color: #f3efe7;
    color: #1a1a1a;
    transform: translateX(2px);
  }

  .featured-collections__title:focus-visible,
  .featured-collections__links a:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 3px;
  }

  @media (max-width: 900px) {
    .featured-collections__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
      padding: 3.25rem 0.25rem 1.75rem;
    }

    .featured-collections__intro {
      max-width: 48ch;
    }
  }

  /* Tablet: 2 columns */
  @media (max-width: 768px) {
    .featured-collections {
      grid-template-columns: repeat(2, 1fr);
    }

    .featured-collections__header {
      padding-top: 2.75rem;
    }

    .featured-collections__heading {
      font-size: clamp(2rem, 7vw, 2.5rem);
    }

    .featured-collections__content {
      gap: 0.6rem;
      padding: 1rem;
    }

    .featured-collections__title {
      font-size: 1.25rem;
    }

    .featured-collections__arrow {
      width: 2rem;
      height: 2rem;
    }
  }
{% endstylesheet %}

