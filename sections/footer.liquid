{%- comment -%}
  Section: Footer
  Description: Bold Allbirds-inspired footer — dramatic typography, generous spacing,
  premium newsletter section, prominent social icons, elevated bottom bar.
{%- endcomment -%}

{%- assign bg = section.settings.background_color -%}
{%- assign text = section.settings.text_color -%}
{%- assign accent = section.settings.accent_color -%}
{%- assign has_social = false -%}
{%- if section.settings.social_instagram != blank -%}
  {%- assign has_social = true -%}
{%- elsif section.settings.social_pinterest != blank -%}
  {%- assign has_social = true -%}
{%- elsif section.settings.social_facebook != blank -%}
  {%- assign has_social = true -%}
{%- elsif section.settings.social_tiktok != blank -%}
  {%- assign has_social = true -%}
{%- elsif section.settings.social_youtube != blank -%}
  {%- assign has_social = true -%}
{%- endif -%}

<footer
  class="site-footer"
  style="--footer-bg: {{ bg }}; --footer-text: {{ text }}; --footer-accent: {{ accent }};"
>
  {%- comment -%} Brand statement — big, bold hero {%- endcomment -%}
  {% if section.settings.brand_statement != blank %}
    <div class="site-footer__brand-wrap">
      <p class="site-footer__brand">
        {{ section.settings.brand_statement }}
      </p>
    </div>
  {% endif %}

  {%- comment -%} Main zone — newsletter (left) + link columns (right) + social (bottom-left) {%- endcomment -%}
  <div class="site-footer__main">
    {% if section.settings.show_newsletter %}
      <div
        class="site-footer__newsletter"
        x-data="{ newsletterSuccess: false }"
      >
        <h2 class="site-footer__label">
          {{ section.settings.newsletter_heading }}
        </h2>

        {% form 'customer' %}
          <input type="hidden" name="contact[tags]" value="newsletter">

          {%- if form.posted_successfully? -%}
            <div x-init="newsletterSuccess = true"></div>
          {%- endif -%}

          <div x-show="!newsletterSuccess" class="site-footer__newsletter-form">
            {%- if form.errors -%}
              <div class="site-footer__form-errors" role="alert">
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}

            <div class="site-footer__newsletter-row">
              <input
                type="email"
                name="contact[email]"
                class="site-footer__input"
                placeholder="Email address"
                  aria-label="Email address"
                required
              >
              <button type="submit" class="site-footer__btn">Sign Up</button>
            </div>
          </div>

          <div x-show="newsletterSuccess" x-cloak class="site-footer__newsletter-success">
            <p>{{ section.settings.newsletter_success_message }}</p>
          </div>
        {% endform %}
      </div>
    {% endif %}

    {%- comment -%} Blocks — footer-column entries + any @theme blocks {%- endcomment -%}
    <div class="site-footer__columns">
      {% content_for 'blocks' %}
    </div>

    {%- comment -%} Social — circular icons, bottom-left {%- endcomment -%}
    {% if section.settings.show_social_links and has_social %}
      <div class="site-footer__social">
        <h3 class="site-footer__label">{{ section.settings.social_heading }}</h3>

        <div class="site-footer__social-icons">
        {% if section.settings.social_instagram != blank %}
          <a href="{{ section.settings.social_instagram }}" target="_blank" rel="noopener noreferrer" class="site-footer__social-link" aria-label="Instagram">
            <span class="site-footer__social-circle">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
            </span>
          </a>
        {% endif %}
        {% if section.settings.social_pinterest != blank %}
          <a href="{{ section.settings.social_pinterest }}" target="_blank" rel="noopener noreferrer" class="site-footer__social-link" aria-label="Pinterest">
            <span class="site-footer__social-circle">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2C6.477 2 2 6.477 2 12c0 4.237 2.636 7.855 6.356 9.312-.088-.791-.167-2.005.035-2.868.182-.78 1.172-4.971 1.172-4.971s-.299-.599-.299-1.484c0-1.391.806-2.428 1.809-2.428.853 0 1.265.64 1.265 1.408 0 .858-.546 2.141-.828 3.329-.236.996.499 1.807 1.481 1.807 1.777 0 3.143-1.874 3.143-4.579 0-2.394-1.72-4.068-4.177-4.068-2.845 0-4.515 2.134-4.515 4.34 0 .859.331 1.781.744 2.282a.3.3 0 01.069.287c-.076.316-.245.996-.278 1.135-.044.183-.145.222-.334.133-1.249-.582-2.03-2.408-2.03-3.874 0-3.154 2.292-6.052 6.608-6.052 3.469 0 6.165 2.472 6.165 5.776 0 3.447-2.173 6.22-5.189 6.22-1.013 0-1.966-.527-2.292-1.148 0 0-.501 1.909-.623 2.378-.226.868-.835 1.956-1.243 2.621.935.289 1.926.445 2.958.445 5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
              </svg>
            </span>
          </a>
        {% endif %}
        {% if section.settings.social_facebook != blank %}
          <a href="{{ section.settings.social_facebook }}" target="_blank" rel="noopener noreferrer" class="site-footer__social-link" aria-label="Facebook">
            <span class="site-footer__social-circle">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
              </svg>
            </span>
          </a>
        {% endif %}
        {% if section.settings.social_tiktok != blank %}
          <a href="{{ section.settings.social_tiktok }}" target="_blank" rel="noopener noreferrer" class="site-footer__social-link" aria-label="TikTok">
            <span class="site-footer__social-circle">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path>
              </svg>
            </span>
          </a>
        {% endif %}
        {% if section.settings.social_youtube != blank %}
          <a href="{{ section.settings.social_youtube }}" target="_blank" rel="noopener noreferrer" class="site-footer__social-link" aria-label="YouTube">
            <span class="site-footer__social-circle">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29.94 29.94 0 0 0 1 12a29.94 29.94 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.94 2C5.12 20 12 20 12 20s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2A29.94 29.94 0 0 0 23 12a29.94 29.94 0 0 0-.46-5.58z"></path>
                <polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"></polygon>
              </svg>
            </span>
          </a>
        {% endif %}
      </div>
    </div>
  {% endif %}

  {%- comment -%} Bottom bar — elevated from main content {%- endcomment -%}
  <div class="site-footer__bottom-wrap">
    <div class="site-footer__bottom">
      <div class="site-footer__bottom-left">
        <span>
          {%- if section.settings.copyright_text != blank -%}
            {{ section.settings.copyright_text }}
          {%- else -%}
            &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}
          {%- endif -%}
        </span>

        {% if section.settings.legal_menu != blank %}
          <nav class="site-footer__legal">
            {% for link in section.settings.legal_menu.links %}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {% endfor %}
          </nav>
        {% endif %}
      </div>

      {% if section.settings.show_payment_icons %}
        <div class="site-footer__payment">
          {% for type in shop.enabled_payment_types %}
            {{ type | payment_type_svg_tag }}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</footer>

{% stylesheet %}
  /* ===== Base ===== */
  .site-footer {
    background-color: var(--footer-bg);
    color: var(--footer-text);
    font-family: var(--font-primary--family, inherit);
    overflow: hidden;
    border-top-left-radius: 2rem;
    border-top-right-radius: 2rem;
    /* Breathing room above the rounded corners — matches the hero's inset */
    margin-top: 0.75rem;
  }

  /* ===== Brand ===== */
  .site-footer__brand-wrap {
    padding: 5rem 1.5rem 4rem;
  }

  @media (min-width: 768px) {
    .site-footer__brand-wrap {
      padding: 7rem 1.5rem 5rem;
    }
  }

  .site-footer__brand {
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    max-width: 24ch;
    margin: 0 auto;
    text-align: center;
  }

  @media (min-width: 768px) {
    .site-footer__brand {
      font-size: 3.75rem;
      line-height: 1.05;
    }
  }

  /* ===== Main zone grid — newsletter / columns / social ===== */
  .site-footer__main {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding: 2.5rem 1.5rem 3rem;
  }

  @media (min-width: 768px) {
    .site-footer__main {
      grid-template-columns: minmax(280px, 2fr) 3fr;
      grid-template-areas:
        'newsletter columns'
        'social columns';
      gap: 3rem 4rem;
      max-width: 80rem;
      margin: 0 auto;
      padding: 3.25rem 1.5rem 3.5rem;
    }

    .site-footer__newsletter {
      grid-area: newsletter;
    }

    .site-footer__columns {
      grid-area: columns;
    }

    .site-footer__social {
      grid-area: social;
      align-self: end;
    }
  }

  /* Shared mono label — newsletter + social headings */
  .site-footer__label {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin: 0 0 1.25rem 0;
    opacity: 0.75;
  }

  .site-footer__newsletter {
    min-width: 0;
  }

  .site-footer__newsletter-form {
    /* wrapper for the form inputs */
  }

  .site-footer__form-errors {
    font-size: 0.8125rem;
    margin-bottom: 1rem;
    opacity: 0.8;
  }

  /* Filled white pill — inverted theme colors */
  .site-footer__newsletter-row {
    display: flex;
    align-items: stretch;
    background-color: var(--footer-text);
    border: 2px solid transparent;
    border-radius: 9999px;
    overflow: hidden;
    transition: border-color 0.25s ease;
  }

  .site-footer__newsletter-row:focus-within {
    border-color: var(--footer-accent);
  }

  .site-footer__input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: var(--footer-bg);
    font-size: 1rem;
    padding: 1rem 1.5rem;
    min-width: 0;
  }

  .site-footer__input::placeholder {
    color: var(--footer-bg);
    opacity: 0.45;
  }

  .site-footer__btn {
    background: transparent;
    color: var(--footer-bg);
    border: none;
    padding: 1rem 1.75rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }

  .site-footer__btn:hover {
    opacity: 0.6;
  }

  .site-footer__newsletter-success {
    padding: 3rem 0;
    font-size: 1.125rem;
    font-weight: 500;
  }

  /* ===== Link columns (right cell) ===== */
  .site-footer__columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    min-width: 0;
  }

  @media (min-width: 768px) {
    .site-footer__columns {
      grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
      gap: 3rem;
    }
  }

  /* ===== Social — bottom-left ===== */
  .site-footer__social-icons {
    display: flex;
    justify-content: flex-start;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .site-footer__social-link {
    text-decoration: none;
  }

  .site-footer__social-circle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 2px solid color-mix(in srgb, var(--footer-text) 20%, transparent);
    color: var(--footer-text);
    opacity: 0.7;
    transition: all 0.3s ease;
  }

  .site-footer__social-circle:hover {
    border-color: var(--footer-accent);
    background-color: var(--footer-accent);
    color: var(--footer-bg);
    opacity: 1;
    transform: translateY(-3px);
  }

  /* ===== Bottom Bar ===== */
  .site-footer__bottom-wrap {
    background-color: color-mix(in srgb, var(--footer-text) 4%, var(--footer-bg));
    border-top: 1px solid color-mix(in srgb, var(--footer-text) 8%, transparent);
    padding: 1.5rem 1.5rem;
  }

  .site-footer__bottom {
    max-width: 72rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    font-size: 0.8125rem;
    opacity: 0.55;
  }

  @media (min-width: 768px) {
    .site-footer__bottom {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  .site-footer__bottom-left {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  @media (min-width: 768px) {
    .site-footer__bottom-left {
      flex-direction: row;
      gap: 1.5rem;
    }
  }

  .site-footer__legal {
    display: flex;
    gap: 1rem;
  }

  .site-footer__legal a {
    text-decoration: none;
    color: inherit;
    transition: opacity 0.2s ease;
  }

  .site-footer__legal a:hover {
    opacity: 1;
  }

  .site-footer__payment {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .site-footer__payment svg {
    height: 22px;
    width: auto;
  }

  /* ===== Global link styles ===== */
  .site-footer a,
  .site-footer a:visited,
  .site-footer a:active {
    color: inherit;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "tag": "footer",
  "class": "site-footer",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#A8D8B9"
    },
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "text",
      "id": "brand_statement",
      "label": "Brand statement"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Subscribe to our emails"
    },
    {
      "type": "text",
      "id": "newsletter_success_message",
      "label": "Success message",
      "default": "Thanks for subscribing!"
    },
    {
      "type": "header",
      "content": "Social media"
    },
    {
      "type": "checkbox",
      "id": "show_social_links",
      "label": "Show social links",
      "default": true
    },
    {
      "type": "text",
      "id": "social_heading",
      "label": "Social heading",
      "default": "Follow The Flock"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "social_pinterest",
      "label": "Pinterest URL"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "social_tiktok",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "social_youtube",
      "label": "YouTube URL"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "info": "Leave blank to auto-generate: © YEAR Shop Name"
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Legal links"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    }
  ],
  "blocks": [
    { "type": "footer-column" },
    { "type": "group" },
    { "type": "@theme" }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
