<div
  class="hero-slider full-width"
  x-data="{
    current: 0,
    total: 2,
    autoplay: null,
    reduced: window.matchMedia('(prefers-reduced-motion: reduce)').matches,
    init() {
      if (!this.reduced) this.startAutoplay();
    },
    startAutoplay() {
      if (this.reduced) return;
      this.stopAutoplay();
      this.autoplay = setInterval(() => {
        this.current = (this.current + 1) % this.total;
      }, 5000);
    },
    stopAutoplay() {
      clearInterval(this.autoplay);
      this.autoplay = null;
    },
    go(index) {
      this.current = index;
      this.startAutoplay();
    },
    destroy() {
      this.stopAutoplay();
    }
  }"
  @mouseenter="stopAutoplay()"
  @mouseleave="startAutoplay()"
  @focusin="stopAutoplay()"
  @focusout="startAutoplay()"
>

  {%- comment -%} ── Slides ── {%- endcomment -%}
  <div class="hero-slider__track">

    {%- if section.settings.image_1 -%}
      <div
        class="hero-slider__slide"
        :class="{ 'is-active': current === 0 }"
      >
        {{
          section.settings.image_1
          | image_url: width: 2400
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            class: 'hero-slider__img',
            widths: '800,1200,1600,2000,2400',
            sizes: '100vw'
        }}
      </div>
    {%- else -%}
      <div class="hero-slider__slide hero-slider__slide--placeholder is-active">
        <div class="hero-slider__placeholder-img"></div>
      </div>
    {%- endif -%}

    {%- if section.settings.image_2 -%}
      <div
        class="hero-slider__slide"
        :class="{ 'is-active': current === 1 }"
      >
        {{
          section.settings.image_2
          | image_url: width: 2400
          | image_tag:
            loading: 'lazy',
            class: 'hero-slider__img',
            widths: '800,1200,1600,2000,2400',
            sizes: '100vw'
        }}
      </div>
    {%- else -%}
      <div
        class="hero-slider__slide hero-slider__slide--placeholder"
        :class="{ 'is-active': current === 1 }"
      >
        <div class="hero-slider__placeholder-img"></div>
      </div>
    {%- endif -%}

    {%- comment -%} ── Progress bar navigation ── {%- endcomment -%}
    <div class="hero-slider__progress" role="tablist" aria-label="Slide navigation">
      <button
        class="hero-slider__prog-item"
        :class="{ 'is-active': current === 0, 'is-done': current > 0 }"
        @click="go(0)"
        role="tab"
        :aria-selected="current === 0"
        aria-label="Go to slide 1"
      ><span class="hero-slider__prog-fill"></span></button>
      <button
        class="hero-slider__prog-item"
        :class="{ 'is-active': current === 1, 'is-done': current > 1 }"
        @click="go(1)"
        role="tab"
        :aria-selected="current === 1"
        aria-label="Go to slide 2"
      ><span class="hero-slider__prog-fill"></span></button>
    </div>

  </div>

  {%- comment -%} ── Right overlay panel ── {%- endcomment -%}
  <div class="hero-slider__overlay" aria-label="Featured content">
    <div class="hero-slider__overlay-inner">

      {%- comment -%}
        Eyebrow: mirrors Allbirds' p.z-content.font-mono.text-xs/5.font-medium.tracking-widest.uppercase
      {%- endcomment -%}
      <p class="hero-slider__eyebrow">
        {{- section.settings.eyebrow | default: 'Introducing the Collection' -}}
      </p>

      {%- comment -%}
        Heading: mirrors Allbirds' h1.z-content.text-2xl/8.tracking-wide
      {%- endcomment -%}
      <h1 class="hero-slider__heading">
        {{- section.settings.heading | default: 'No More Business As Usual' -}}
      </h1>

      <div class="hero-slider__buttons">

        {%- assign cta_1 = section.settings.collection_1 -%}
        {%- assign cta_2 = section.settings.collection_2 -%}

        {%- if cta_1 != blank -%}
          <a
            href="{{ cta_1.url }}"
            class="hero-slider__btn hero-slider__btn--primary"
          >
            {{- section.settings.button_1_label | default: cta_1.title -}}
          </a>
        {%- else -%}
          <a href="{{ routes.all_products_collection_url }}" class="hero-slider__btn hero-slider__btn--primary">
            {{- section.settings.button_1_label | default: 'Shop Men' -}}
          </a>
        {%- endif -%}

        {%- if cta_2 != blank -%}
          <a
            href="{{ cta_2.url }}"
            class="hero-slider__btn hero-slider__btn--secondary"
          >
            {{- section.settings.button_2_label | default: cta_2.title -}}
          </a>
        {%- else -%}
          <a href="{{ routes.all_products_collection_url }}" class="hero-slider__btn hero-slider__btn--secondary">
            {{- section.settings.button_2_label | default: 'Shop Women' -}}
          </a>
        {%- endif -%}

      </div>
    </div>
  </div>

</div>

{% stylesheet %}

  /* ── Ken Burns keyframe ── */
  @keyframes hero-kenburns {
    from { transform: scale(1);    }
    to   { transform: scale(1.06); }
  }

  /* ── Wrapper — card inset from all sides, header sits on top ── */
  .hero-slider {
    position: relative;
    aspect-ratio: 16 / 9;
    max-height: 72vh;
    overflow: hidden;
    background: #111111;
    border-radius: 1rem;
    margin: 0.75rem;
    width: calc(100% - 1.5rem);
  }

  /* ── Slide track fills wrapper ── */
  .hero-slider__track {
    position: absolute;
    inset: 0;
  }

  /* ── Individual slides ── */
  .hero-slider__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.1s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: opacity;
  }

  .hero-slider__slide.is-active {
    opacity: 1;
  }

  /* Ken Burns only fires on the active slide */
  .hero-slider__slide.is-active .hero-slider__img {
    animation: hero-kenburns 7s ease-out forwards;
  }

  .hero-slider__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    max-width: 100%;
  }

  /* ── Placeholder (editor — no image uploaded yet) ── */
  .hero-slider__placeholder-img {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #1c1c1c 0%, #2e2e2e 50%, #1c1c1c 100%);
  }

  /* ── Progress bar navigation ── */
  @keyframes prog-fill {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }

  .hero-slider__progress {
    position: absolute;
    bottom: 1.25rem;
    left: 1.5rem;
    right: 1.5rem;
    display: flex;
    gap: 6px;
    z-index: 10;
  }

  .hero-slider__prog-item {
    flex: 1;
    /* 3px visual bar centered in a 23px hit area (padding + background-clip) */
    height: 23px;
    padding: 10px 0;
    border-radius: 2px;
    border: none;
    background: rgba(255, 255, 255, 0.28);
    background-clip: content-box;
    cursor: pointer;
    position: relative;
    overflow: hidden;
  }

  .hero-slider__prog-fill {
    display: block;
    position: absolute;
    inset: 0;
    padding: 10px 0;
    background: #ffffff;
    background-clip: content-box;
    border-radius: 2px;
    transform: scaleX(0);
    transform-origin: left center;
  }

  /* Active: fill animates across over 5s */
  .hero-slider__prog-item.is-active .hero-slider__prog-fill {
    animation: prog-fill 5s linear forwards;
  }

  /* Completed: instantly fully filled */
  .hero-slider__prog-item.is-done .hero-slider__prog-fill {
    transform: scaleX(1);
  }

  .hero-slider__prog-item:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  /* ── Top vignette — keeps floating header legible over any image ── */
  .hero-slider__track::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 30%;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.35) 0%,
      rgba(0, 0, 0, 0) 100%
    );
    z-index: 4;
    pointer-events: none;
  }

  /* ── Right overlay panel ── */
  .hero-slider__overlay {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    /* ~38% wide — enough for two pill buttons side-by-side */
    width: clamp(280px, 38%, 440px);
    display: flex;
    align-items: center;
    justify-content: flex-start;
    z-index: 5;
    /*
      Allbirds-style: generous dark fade from the right edge inward.
      No hard border — seamlessly dissolves into the photo.
    */
    background: linear-gradient(
      to left,
      rgba(0, 0, 0, 0.65) 0%,
      rgba(0, 0, 0, 0.48) 55%,
      rgba(0, 0, 0, 0) 100%
    );
  }

  .hero-slider__overlay-inner {
    padding: 2.5rem 2.5rem 2.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    color: #ffffff;
  }

  /*
    Eyebrow — mirrors:
    p.font-mono.text-xs/5.font-medium.tracking-widest.uppercase
    text-xs  = 0.75rem
    /5       = line-height 1.25rem
    tracking-widest = 0.1em
  */
  .hero-slider__eyebrow {
    position: relative;
    z-index: 1;
    margin-bottom: 1rem;       /* mb-4 */
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.75rem;        /* text-xs */
    line-height: 1.25rem;      /* /5 */
    font-weight: 500;          /* font-medium */
    letter-spacing: 0.1em;     /* tracking-widest */
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.8);
  }

  /*
    Heading — mirrors:
    h1.text-2xl/8.tracking-wide
    text-2xl = 1.5rem
    /8       = line-height 2rem
    tracking-wide = 0.025em
  */
  .hero-slider__heading {
    position: relative;
    z-index: 1;
    margin-bottom: 1.5rem;     /* mb-6 */
    font-size: 1.5rem;         /* text-2xl */
    line-height: 2rem;         /* /8 */
    letter-spacing: 0.025em;   /* tracking-wide */
    font-weight: 400;
    color: #ffffff;
  }

  /* ── Buttons — side by side ── */
  .hero-slider__buttons {
    display: flex;
    flex-direction: row;
    gap: 0.625rem;
  }

  /* Shared pill base */
  .hero-slider__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.6875rem 1.75rem;   /* Allbirds ~11px 28px */
    border-radius: 9999px;        /* pill */
    font-size: 0.875rem;          /* text-sm */
    font-weight: 500;
    letter-spacing: 0.01em;
    text-decoration: none;
    text-align: center;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    cursor: pointer;
    white-space: nowrap;
  }

  /* Primary — white fill, black text */
  .hero-slider__btn--primary {
    background: #ffffff;
    color: #000000;
    border: 1.5px solid #ffffff;
  }

  .hero-slider__btn--primary:hover {
    background: rgba(255, 255, 255, 0.88);
  }

  /* Secondary — outlined white */
  .hero-slider__btn--secondary {
    background: transparent;
    color: #ffffff;
    border: 1.5px solid rgba(255, 255, 255, 0.7);
  }

  .hero-slider__btn--secondary:hover {
    border-color: #ffffff;
    background: rgba(255, 255, 255, 0.1);
  }

  /* ── Mobile — 4:5 portrait ── */
  @media (max-width: 640px) {
    .hero-slider {
      aspect-ratio: 4 / 5;
      max-height: 100svh;
      border-radius: 0.75rem;
      margin: 0.75rem;
      width: calc(100% - 1.5rem);
    }

    /* Panel drops to bottom of slide */
    .hero-slider__overlay {
      width: 100%;
      height: auto;
      top: auto;
      bottom: 0;
      align-items: flex-end;
      background: linear-gradient(
        to top,
        rgba(0, 0, 0, 0.72) 0%,
        rgba(0, 0, 0, 0.42) 55%,
        rgba(0, 0, 0, 0) 100%
      );
    }

    .hero-slider__overlay-inner {
      padding: 1.25rem 1.25rem 3rem;
      width: 100%;
    }

    .hero-slider__btn {
      flex: 1;
      padding: 0.6875rem 1rem;
    }

    /* Progress bars stay at the bottom (desktop placement) — the overlay's
       3rem bottom padding keeps the text panel clear of them */
  }

{% endstylesheet %}

{% schema %}
{
  "name": "Hero Slider",
  "settings": [
    {
      "type": "header",
      "content": "Slides"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Slide 1 image"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Slide 2 image"
    },
    {
      "type": "header",
      "content": "Overlay text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (small label above heading)",
      "default": "Introducing the Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "No More Business As Usual"
    },
    {
      "type": "header",
      "content": "Button 1"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Button 1 label",
      "default": "Shop Men"
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "Button 1 collection"
    },
    {
      "type": "header",
      "content": "Button 2"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Button 2 label",
      "default": "Shop Women"
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "Button 2 collection"
    }
  ],
  "presets": [
    {
      "name": "Hero Slider"
    }
  ]
}
{% endschema %}
