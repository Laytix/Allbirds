{%- comment -%}
  Block: footer-column
  Description: Navigation column for the footer with heading and links.
  On mobile (< 768px), collapses into an accordion toggle. On desktop,
  links are always visible.
{%- endcomment -%}

<div
  class="footer-column"
  x-data="{ open: false }"
  {{ block.shopify_attributes }}
>
  <button
    class="footer-column__toggle"
    @click="open = !open"
    :aria-expanded="open"
  >
    <span>{{ block.settings.heading }}</span>
    <span
      x-text="open ? '\u2212' : '+'"
      class="footer-column__toggle-icon"
    ></span>
  </button>

  <h3 class="footer-column__heading">
    {{ block.settings.heading }}
  </h3>

  <ul
    class="footer-column__links"
    x-show="open"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 -translate-y-1"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 -translate-y-1"
    x-cloak
  >
    {% for link in block.settings.menu.links %}
      <li class="footer-column__link-item">
        <a href="{{ link.url }}" class="footer-column__link">
          {{ link.title }}
        </a>
      </li>
    {% endfor %}
  </ul>
</div>

{% stylesheet %}
  .footer-column {
    font-family: var(--font-primary--family, inherit);
  }

  /* ===== Mobile toggle ===== */
  .footer-column__toggle {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 0;
    background: none;
    border: none;
    border-bottom: 1px solid;
    border-color: color-mix(in srgb, currentColor 12%, transparent);
    cursor: pointer;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: inherit;
    font-family: inherit;
  }

  .footer-column__toggle-icon {
    font-size: 1.25rem;
    font-weight: 300;
    opacity: 0.5;
    transition: opacity 0.2s ease;
  }

  .footer-column__toggle:hover .footer-column__toggle-icon {
    opacity: 1;
  }

  /* ===== Desktop heading ===== */
  .footer-column__heading {
    display: none;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 1.25rem 0;
    opacity: 0.9;
  }

  /* ===== Links ===== */
  .footer-column__links {
    list-style: none;
    padding: 0 0 1.25rem 0;
    margin: 0;
  }

  .footer-column__link-item {
    /* spacing handled by link padding */
  }

  .footer-column__link {
    display: inline-block;
    padding: 0.25rem 0;
    font-size: 0.9375rem;
    text-decoration: none;
    color: inherit;
    opacity: 0.6;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .footer-column__link:hover {
    opacity: 1;
    transform: translateX(3px);
  }

  /* ===== Desktop overrides ===== */
  @media (min-width: 768px) {
    .footer-column__toggle {
      display: none !important;
    }

    .footer-column__heading {
      display: block;
    }

    .footer-column__links {
      display: block !important;
      padding-bottom: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer Column",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Column heading",
      "default": "Column"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Column menu"
    }
  ],
  "presets": [
    {
      "name": "Footer Column",
      "category": "Footer"
    }
  ]
}
{% endschema %}
