{%- comment -%}
  Block: footer-column
  Description: Navigation column for the footer with heading and links.
  On mobile (< 768px), collapses into a Flowbite accordion. On desktop,
  links are always visible.
{%- endcomment -%}

<div
  class="footer-column"
  data-accordion="collapse"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.heading != blank -%}
    <button
      type="button"
      class="footer-column__toggle"
      data-accordion-target="#footer-col-{{ block.id }}"
      aria-expanded="false"
      aria-controls="footer-col-{{ block.id }}"
    >
      <span>{{ block.settings.heading }}</span>
      <svg
        data-accordion-icon
        class="footer-column__toggle-icon"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="3"
      >
        <path d="M6 9l6 6 6-6"/>
      </svg>
    </button>

    <h3 class="footer-column__heading">
      {{ block.settings.heading }}
    </h3>
  {%- endif -%}

  <ul
    id="footer-col-{{ block.id }}"
    class="footer-column__links"
    hidden
  >
    {% for link in block.settings.menu.links %}
      <li>
        <a href="{{ link.url }}" class="footer-column__link">
          {{ link.title }}
        </a>
      </li>
    {% endfor %}
  </ul>
</div>

{% stylesheet %}
  .footer-column {
    font-family: var(--font-primary--family, inherit);
  }

  /* ===== Mobile toggle ===== */
  .footer-column__toggle {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 0;
    background: none;
    border: none;
    border-bottom: 1px solid;
    border-color: color-mix(in srgb, currentColor 12%, transparent);
    cursor: pointer;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: inherit;
  }

  .footer-column__toggle-icon {
    width: 14px;
    height: 14px;
    opacity: 0.5;
    transition: transform 0.3s ease, opacity 0.2s ease;
    flex-shrink: 0;
  }

  .footer-column__toggle:hover .footer-column__toggle-icon {
    opacity: 1;
  }

  /* Flowbite rotates the icon when open */
  [data-accordion].footer-column [aria-expanded="true"] .footer-column__toggle-icon {
    opacity: 1;
  }

  /* ===== Desktop heading ===== */
  .footer-column__heading {
    display: none;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin: 0 0 1.25rem 0;
    opacity: 0.85;
  }

  /* ===== Links ===== */
  .footer-column__links {
    list-style: none;
    padding: 0 0 1.25rem 0;
    margin: 0;
  }

  .footer-column__link {
    display: inline-block;
    padding: 0.25rem 0;
    font-size: 0.9375rem;
    text-decoration: none;
    color: inherit;
    opacity: 0.65;
    transition: opacity 0.2s ease;
  }

  .footer-column__link:hover {
    opacity: 1;
  }

  /* ===== Desktop overrides ===== */
  @media (min-width: 768px) {
    .footer-column__toggle {
      display: none !important;
    }

    .footer-column__heading {
      display: block;
    }

    .footer-column__links {
      display: block !important;
      padding-bottom: 0;
    }

    .footer-column__links[hidden] {
      display: block !important;
    }
  }

  /* Remove the hidden attribute visually on desktop */
  @media (min-width: 768px) {
    .footer-column[data-accordion="collapse"] [hidden] {
      display: block !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer Column",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Column heading",
      "default": "Column"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Column menu"
    }
  ],
  "presets": [
    {
      "name": "Footer Column",
      "category": "Footer"
    }
  ]
}
{% endschema %}
