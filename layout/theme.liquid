<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% comment %}
      Font preloading:
      1. Preconnect to font CDN for faster connection
      2. Preload only the critical font variant (base weight)
      3. Additional variants load on-demand via @font-face
    {% endcomment %}
    {% unless settings.type_primary_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

      {% comment %} Preload the base font variant for initial page render {% endcomment %}
      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

     {%- comment -%} Preconnect to CDNs for faster loading {%- endcomment -%}
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- comment -%} ========== CSS ========== {%- endcomment -%}

    {%- comment -%} 1. Tailwind CSS (compiled output from CLI build) {%- endcomment -%}
    {{ 'application.css' | asset_url | stylesheet_tag }}

    {%- comment -%} 2. Flowbite CSS (CDN — component styles) {%- endcomment -%}
    <link href="https://cdn.jsdelivr.net/npm/flowbite@4.0.1/dist/flowbite.min.css" rel="stylesheet">

    {%- comment -%} 3. Alpine.js (CDN — defer so it runs after DOM parse) {%- endcomment -%}
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.9/dist/cdn.min.js"></script>

    {%- comment -%} 4. Alpine.js global stores (must load before Alpine starts) {%- endcomment -%}
    <script src="{{ 'alpine-stores.js' | asset_url }}" defer></script>


    {{ content_for_header }}
  </head>

  <body>
    {% sections 'header-group' %}

    {{ content_for_layout }}

    {% sections 'footer-group' %}
  </body>
</html>
